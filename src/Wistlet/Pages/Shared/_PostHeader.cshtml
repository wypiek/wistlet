@model PostHeaderModel
@{
    var p = Model.Post;
    var full = p.CreatedAt.ToString("ddd, MMM d, yyyy, h:mm tt", System.Globalization.CultureInfo.InvariantCulture) + " UTC";
}
<div class="i-post-header">
    <img class="co-avatar i-avatar" data-shape="@p.Author.AvatarShape" src="@p.Author.AvatarUrl" alt="@p.Author.UserName" loading="lazy" />
    <a class="co-project-display-name" rel="author" href="/u/@p.Author.UserName" title="@p.Author.DisplayName">@p.Author.DisplayName</a>
    <a class="co-project-handle" href="/u/@p.Author.UserName">@@@p.Author.UserName</a>
    <partial name="_Badges" model="p.Author" />
    <time class="i-timestamp" datetime="@p.CreatedAt.ToString("o")" title="@full"><a href="/post/@p.Id">@Fmt.AgoLong(p.CreatedAt)@(p.EditedAt is not null ? " (edited)" : "")</a></time>
    @if (Model.SharedFrom is { } from)
    {
        <svg class="i-share-icon" viewBox="0 0 24 24" height="24" fill="currentColor" aria-label="shared from">
            <path fill-rule="evenodd" d="M4.755 10.059a7.5 7.5 0 0112.548-3.364l1.903 1.903h-3.183a.75.75 0 100 1.5h4.992a.75.75 0 00.75-.75V4.356a.75.75 0 00-1.5 0v3.18l-1.9-1.9A9 9 0 003.306 9.67a.75.75 0 101.45.388zm15.408 3.352a.75.75 0 00-.919.53 7.5 7.5 0 01-12.548 3.364l-1.902-1.903h3.183a.75.75 0 000-1.5H2.984a.75.75 0 00-.75.75v4.992a.75.75 0 001.5 0v-3.18l1.9 1.9a9 9 0 0015.059-4.035.75.75 0 00-.53-.918z" clip-rule="evenodd"></path>
        </svg>
        <img class="co-avatar i-avatar" data-shape="@from.Author.AvatarShape" src="@from.Author.AvatarUrl" alt="@from.Author.UserName" loading="lazy" />
        <a class="co-project-display-name" rel="author" href="/u/@from.Author.UserName" title="@from.Author.DisplayName">@from.Author.DisplayName</a>
        <a class="co-project-handle" href="/u/@from.Author.UserName">@@@from.Author.UserName</a>
    }
</div>
