@model SidebarModel
@{
    var cfg = Settings.Current;
}
@if (!Model.SignedIn)
{
    <section class="co-themed-titled-box">
        <h2 class="i-header">welcome to @cfg.SiteName.ToLowerInvariant()!</h2>
        <div class="i-contents">
            <p>@cfg.Tagline</p>
            <div class="row">
                @if (cfg.RegistrationOpen)
                {
                    <a class="co-button" href="/account/register">sign up</a>
                }
                <a class="co-button is-outline" href="/account/login">log in</a>
            </div>
        </div>
    </section>
}
@if (Model.FollowedTags.Count > 0)
{
    <details class="co-themed-titled-box" open>
        <summary class="i-header">followed tags</summary>
        <div class="i-contents feed-related-tag-list">
            <div class="i-tag-list">
                @foreach (var t in Model.FollowedTags)
                {
                    <a class="co-tag-button is-small" href="/tag/@Uri.EscapeDataString(t)">@t</a>
                }
            </div>
        </div>
    </details>
}
@if (Model.Trending.Count > 0)
{
    <details class="co-themed-titled-box" open>
        <summary class="i-header">trending tags</summary>
        <div class="i-contents feed-related-tag-list">
            <div class="i-tag-list">
                @foreach (var t in Model.Trending)
                {
                    <a class="co-tag-button is-small" href="/tag/@Uri.EscapeDataString(t.Tag)" title="@Fmt.Plural(t.Count, "post") this week">@t.Tag</a>
                }
            </div>
        </div>
    </details>
}
