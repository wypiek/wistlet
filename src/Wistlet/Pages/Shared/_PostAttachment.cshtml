@model IReadOnlyList<AttachmentView>
@* A post's images in the rows its author chose (cohost's attachment rows); a row shows up to four side by side.
   Clicking one opens the lightbox (site.js). *@
@if (Model.Count > 0)
{
    <div class="co-attachments">
        @foreach (var row in Model.GroupBy(a => a.Row).OrderBy(g => g.Key))
        {
            var items = row.ToList();
            <div class="i-row" data-count="@Math.Min(items.Count, 4)">
                @foreach (var a in items)
                {
                    <a class="i-attachment" href="@a.Url" target="_blank" rel="noopener" data-lightbox data-alt="@a.AltText">
                        <img src="@a.Url" alt="@a.AltText" loading="lazy" />
                        @if (!string.IsNullOrWhiteSpace(a.AltText))
                        {
                            <span class="i-alt-badge" title="@a.AltText">ALT</span>
                        }
                    </a>
                }
            </div>
        }
    </div>
}
