@inject ViewerContext Viewer
@{
    var cfg = Settings.Current;
    var me = await Viewer.GetUserAsync();
    var pages = me is null ? [] : await Viewer.GetPagesAsync();
    var title = ViewData["Title"] as string;
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    var wide = ViewData["NoSidebar"] is true;
    // Profile pages use cohost's project layout: the project box on the left, the menu in the header.
    var project = ViewData["ProjectPage"] is true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#83254f" />
    <title>@(string.IsNullOrEmpty(title) ? cfg.SiteName : $"{cfg.SiteName.ToLowerInvariant()}! - {title}")</title>
    <meta name="description" content="@cfg.Tagline" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/cohost/cohost.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/cohost/tailwind-prose.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<header id="page-header">
    <div class="co-container i-header">
        @if (project)
        {
            <details class="co-dropdown i-nav-menu">
                <summary aria-label="Main menu">
                    <svg viewBox="0 0 24 24" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
                </summary>
                <nav aria-label="Main"><partial name="_SiteNav" model="@("co-menu")" /></nav>
            </details>
        }
        <a href="/" class="i-logo">@cfg.SiteName.ToLowerInvariant()!</a>
        <form class="i-search" action="/search" method="get" role="search">
            <input type="search" name="q" placeholder="search @cfg.SiteName.ToLowerInvariant()" aria-label="Search" value="@(path == "/search" ? Context.Request.Query["q"].ToString() : "")" />
        </form>
        <div class="i-user">
            @if (me is not null)
            {
                <a class="co-button is-light" href="/compose">post</a>
                <details class="co-dropdown">
                    <summary aria-label="Account menu"><img class="co-avatar i-avatar" data-shape="@AvatarShapes.Resolve(me.AvatarShape)" src="@(me.AvatarPath ?? $"/avatar/{me.UserName}.svg")" alt="" /></summary>
                    <ul class="co-menu i-account-menu" role="menu">
                        <li class="i-menu-label">posting as</li>
                        @foreach (var pg in pages)
                        {
                            <li role="menuitem">
                                @if (pg.Id == me.Id)
                                {
                                    <a class="i-page is-current" href="/u/@pg.UserName" aria-current="true">
                                        <img class="co-avatar" data-shape="@AvatarShapes.Resolve(pg.AvatarShape)" src="@(pg.AvatarPath ?? $"/avatar/{pg.UserName}.svg")" alt="" />
                                        <span>@@@pg.UserName</span><span class="i-check">✓</span>
                                    </a>
                                }
                                else
                                {
                                    <button type="submit" class="i-page" form="switch-@pg.Id">
                                        <img class="co-avatar" data-shape="@AvatarShapes.Resolve(pg.AvatarShape)" src="@(pg.AvatarPath ?? $"/avatar/{pg.UserName}.svg")" alt="" />
                                        <span>@@@pg.UserName</span>
                                    </button>
                                }
                            </li>
                        }
                        <li role="menuitem"><a href="/pages">manage pages…</a></li>
                        <li role="menuitem" class="is-divided"><a href="/u/@me.UserName">view page</a></li>
                        <li role="menuitem"><a href="/settings">settings</a></li>
                        <li role="menuitem" class="is-divided"><button type="submit" form="logout-form">log out</button></li>
                    </ul>
                </details>
                <form id="logout-form" method="post" asp-page="/Account/Logout" hidden></form>
                @foreach (var pg in pages.Where(x => x.Id != me.Id))
                {
                    <form id="switch-@pg.Id" method="post" asp-page="/MyPages" asp-page-handler="Switch" asp-route-id="@pg.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" hidden></form>
                }
            }
            else
            {
                <a class="i-link" href="/account/login">log in</a>
                @if (cfg.RegistrationOpen)
                {
                    <a class="co-button is-light" href="/account/register">sign up</a>
                }
            }
        </div>
    </div>
</header>
@await RenderSectionAsync("BaseHeader", required: false)
<div id="page-container" class="co-container @(wide ? "is-wide" : "") @(project ? "is-project-page" : "")">
    @if (!project)
    {
        <nav class="site-nav" aria-label="Main"><partial name="_SiteNav" model="@("")" /></nav>
    }
    else
    {
        @await RenderSectionAsync("ProjectSidebar", required: false)
    }

    <div class="page-contents">
        @if (cfg.AnnouncementEnabled && !string.IsNullOrWhiteSpace(cfg.AnnouncementText))
        {
            <div class="co-info-box is-warning i-info-circle-icon" data-dismiss-key="ann-@Fmt.StableHash(cfg.AnnouncementText)">
                <div class="i-text">@ContentFormatter.Format(cfg.AnnouncementText)</div>
                <button type="button" class="i-dismiss" data-dismiss aria-label="Dismiss announcement">×</button>
            </div>
        }
        @if (cfg.MaintenanceMode && me?.IsStaff == true)
        {
            <div class="co-info-box is-warning i-shield-exclam-icon">
                <div class="i-text">Maintenance mode is on — only staff can use the site. <a href="/admin/settings">Turn it off</a></div>
            </div>
        }
        @if (TempData["Flash"] is string flash)
        {
            <div class="co-info-box is-draft i-info-circle-icon" role="status"><div class="i-text">@flash</div></div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="co-info-box is-warning i-exclam-circle-icon" role="alert"><div class="i-text">@err</div></div>
        }
        @RenderBody()
    </div>

    @if (project)
    {
        <aside class="project-sidebar-alt">
            @await RenderSectionAsync("Aside", required: false)
            <p class="site-fine-print">@cfg.FooterText</p>
        </aside>
    }
    else if (!wide)
    {
        <aside class="feed-sidebar-alt">
            @if (IsSectionDefined("Aside"))
            {
                @await RenderSectionAsync("Aside")
            }
            else
            {
                @await Component.InvokeAsync("Sidebar")
            }
            <p class="site-fine-print">@cfg.FooterText</p>
        </aside>
    }
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
