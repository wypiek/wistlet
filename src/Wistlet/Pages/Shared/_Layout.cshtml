@inject ViewerContext Viewer
@{
    var cfg = Settings.Current;
    var me = await Viewer.GetUserAsync();
    var (unreadNotes, unreadMessages) = await Viewer.GetUnreadCountsAsync();
    var openReports = me?.IsStaff == true ? await Viewer.GetOpenReportCountAsync() : 0;
    var title = ViewData["Title"] as string;
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    string Current(string prefix) =>
        (prefix == "/" ? path == "/" : path == prefix || path.StartsWith(prefix + "/")) ? "page" : "false";
    var wide = ViewData["NoSidebar"] is true;
    // The logged-out home page: a full-width marketing page without the navigation column.
    var landing = ViewData["Landing"] is true;
    // Logged-out visitors follow their device's light or dark setting.
    var theme = Themes.Resolve(me?.Theme);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#83254f" />
    <meta name="color-scheme" content="@(theme switch { Themes.Light => "light", Themes.Dark => "dark", _ => "light dark" })" />
    <title>@(string.IsNullOrEmpty(title) ? cfg.SiteName : $"{cfg.SiteName.ToLowerInvariant()}! - {title}")</title>
    <meta name="description" content="@cfg.Tagline" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/cohost/cohost.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/cohost/tailwind-prose.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (theme == Themes.Dark)
    {
        <link rel="stylesheet" href="~/css/dark.css" asp-append-version="true" />
    }
    else if (theme == Themes.Auto)
    {
        <link rel="stylesheet" href="~/css/dark.css" media="(prefers-color-scheme: dark)" asp-append-version="true" />
    }
</head>
<body>
<header id="page-header">
    <div class="co-container i-header">
        <a href="/" class="i-logo">@cfg.SiteName.ToLowerInvariant()!</a>
        @if (!landing)
        {
            <form class="i-search" action="/search" method="get" role="search">
                <input type="search" name="q" placeholder="search @cfg.SiteName.ToLowerInvariant()" aria-label="Search" value="@(path == "/search" ? Context.Request.Query["q"].ToString() : "")" />
            </form>
        }
        <div class="i-user">
            @if (me is not null)
            {
                <a class="co-button is-light" href="/compose">post</a>
                <details class="co-dropdown">
                    <summary aria-label="Account menu"><img class="co-avatar i-avatar" data-shape="@AvatarShapes.Resolve(me.AvatarShape)" src="@(me.AvatarPath ?? $"/avatar/{me.UserName}.svg")" alt="" /></summary>
                    <ul class="co-menu" role="menu">
                        <li role="menuitem"><a href="/u/@me.UserName">@@@me.UserName</a></li>
                        <li role="menuitem"><a href="/settings">settings</a></li>
                        <li role="menuitem" class="is-divided"><button type="submit" form="logout-form">log out</button></li>
                    </ul>
                </details>
                <form id="logout-form" method="post" asp-page="/Account/Logout" hidden></form>
            }
            else
            {
                <a class="co-button is-light is-header" href="/account/login">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 4.5h4a1.5 1.5 0 0 1 1.5 1.5v12a1.5 1.5 0 0 1-1.5 1.5h-4M10 8l4 4-4 4M14 12H4" /></svg>
                    log in
                </a>
                @if (cfg.RegistrationOpen)
                {
                    <a class="co-button is-light is-header" href="/account/register">
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM3.5 20a6.5 6.5 0 0 1 13 0M19 8v6M16 11h6" /></svg>
                        sign up
                    </a>
                }
            }
        </div>
    </div>
</header>
@await RenderSectionAsync("BaseHeader", required: false)
@if (landing)
{
    <main class="landing">
        @if (TempData["Flash"] is string landingFlash)
        {
            <div class="co-container landing-flash"><div class="co-info-box is-draft i-info-circle-icon" role="status"><div class="i-text">@landingFlash</div></div></div>
        }
        @if (TempData["Error"] is string landingError)
        {
            <div class="co-container landing-flash"><div class="co-info-box is-warning i-exclam-circle-icon" role="alert"><div class="i-text">@landingError</div></div></div>
        }
        @RenderBody()
    </main>
    <footer class="landing-footer co-container">
        <span>@cfg.FooterText</span>
        <a href="/about">about</a>
        @if (cfg.PublicBrowsing) { <a href="/explore">explore</a> }
    </footer>
}
else
{
<div id="page-container" class="co-container @(wide ? "is-wide" : "")">
    <nav class="site-nav" aria-label="Main">
        <ul>
            <li><a href="/" aria-current="@Current("/")">home</a></li>
            <li><a href="/explore" aria-current="@Current("/explore")">explore</a></li>
            @if (me is not null)
            {
                <li><a href="/notifications" aria-current="@Current("/notifications")">notifications @if (unreadNotes > 0) { <span class="i-count">@unreadNotes</span> }</a></li>
                @if (cfg.AllowDirectMessages)
                {
                    <li><a href="/messages" aria-current="@Current("/messages")">messages @if (unreadMessages > 0) { <span class="i-count">@unreadMessages</span> }</a></li>
                }
                <li><a href="/bookmarks" aria-current="@Current("/bookmarks")">saved posts</a></li>
                <li><a href="/u/@me.UserName" aria-current="@Current("/u/" + me.UserName.ToLowerInvariant())">profile</a></li>
                <li><a href="/settings" aria-current="@Current("/settings")">settings</a></li>
            }
            <li><a href="/people" aria-current="@Current("/people")">people</a></li>
            <li><a href="/search" aria-current="@Current("/search")">search</a></li>
            @if (me?.IsStaff == true)
            {
                <li><a href="/admin" aria-current="@Current("/admin")">admin @if (openReports > 0) { <span class="i-count">@openReports</span> }</a></li>
            }
            <li><a href="/about" aria-current="@Current("/about")">about</a></li>
        </ul>
        <footer class="site-footer">@cfg.FooterText</footer>
    </nav>

    <div class="page-contents">
        @if (cfg.AnnouncementEnabled && !string.IsNullOrWhiteSpace(cfg.AnnouncementText))
        {
            <div class="co-info-box is-warning i-info-circle-icon" data-dismiss-key="ann-@Fmt.StableHash(cfg.AnnouncementText)">
                <div class="i-text">@ContentFormatter.Format(cfg.AnnouncementText)</div>
                <button type="button" class="i-dismiss" data-dismiss aria-label="Dismiss announcement">×</button>
            </div>
        }
        @if (cfg.MaintenanceMode && me?.IsStaff == true)
        {
            <div class="co-info-box is-warning i-shield-exclam-icon">
                <div class="i-text">Maintenance mode is on — only staff can use the site. <a href="/admin/settings">Turn it off</a></div>
            </div>
        }
        @if (TempData["Flash"] is string flash)
        {
            <div class="co-info-box is-draft i-info-circle-icon" role="status"><div class="i-text">@flash</div></div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="co-info-box is-warning i-exclam-circle-icon" role="alert"><div class="i-text">@err</div></div>
        }
        @RenderBody()
    </div>

    @if (!wide)
    {
        <aside class="feed-sidebar-alt">
            @if (IsSectionDefined("Aside"))
            {
                @await RenderSectionAsync("Aside")
            }
            else
            {
                @await Component.InvokeAsync("Sidebar")
            }
        </aside>
    }
    @* On narrow screens the navigation sits above the page, so the footer goes at the end instead. *@
    <footer class="site-footer is-bottom">@cfg.FooterText</footer>
</div>
}
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
