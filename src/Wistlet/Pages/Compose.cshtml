@page
@model ComposeModel
@{
    var heading = Model.Sharing is not null ? "share a post" : Model.Answering is not null ? "answer an ask" : "new post";
    ViewData["Title"] = heading;
    var placeholder = Model.Sharing is not null ? "add something (optional)" : Model.Answering is not null ? "your answer" : "what's on your mind?";
    var button = Model.Sharing is not null ? "share" : Model.Answering is not null ? "answer" : "post";
}
<h1 class="page-title">@heading</h1>
<partial name="_ComposerBox" model="@(new ComposerModel("/", Placeholder: placeholder, ButtonText: button) { ShareOfId = Model.Sharing?.Id, Answering = Model.Answering })" />
@if (Model.Sharing is not null)
{
    <h2 class="section-title">sharing</h2>
    <partial name="_PostList" model="@(new PostListModel([Model.Sharing]))" />
}
