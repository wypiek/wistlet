@page "/post/{id:int}/edit"
@model EditPostModel
@{
    ViewData["Title"] = Model.Post.IsDraft ? "Edit draft" : "Edit post";
}
<h1 class="page-title">@(Model.Post.IsDraft ? "edit draft" : "edit post")</h1>
<partial name="_ComposerBox" model="@(new ComposerModel($"/post/{Model.Post.Id}") { Editing = Model.Post, IsComment = Model.Post.ParentId is not null })" />
