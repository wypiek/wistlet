@page "/error"
@model ErrorModel
@{
    var (title, message) = Model.Describe();
    ViewData["Title"] = title;
    ViewData["NoSidebar"] = true;
}
<card title="@($"{Model.Code} — {title}")" class="narrow">
    <p class="instruction instruction-primary">@title</p>
    <p>@message</p>
    @if (Model.Code >= 500)
    {
        <p>Request ID: <code>@Model.RequestId</code></p>
    }
    <div class="row end"><a role="button" class="default" href="/">Go home</a></div>
</card>
