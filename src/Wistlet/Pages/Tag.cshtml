@page "/tag/{tag}"
@model TagModel
@{
    ViewData["Title"] = "#" + Model.Tag;
}
<h1 class="page-title">#@Model.Tag</h1>
@if (User.Identity?.IsAuthenticated == true)
{
    <card>
        <partial name="_Composer" model="@(new ComposerModel($"/tag/{Model.Tag}", Placeholder: $"Say something about #{Model.Tag}…"))" />
    </card>
}
<partial name="_PostList" model="@(new PostListModel(Model.Posts, $"No posts tagged #{Model.Tag} yet.", Model.MoreUrl))" />
