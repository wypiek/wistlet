@page "/u/{userName}/{tab?}/{tag?}"
@model ProfileModel
@{
    var p = Model.Profile;
    var summary = new UserSummary(p.Id, p.UserName, p.DisplayName, p.AvatarPath, p.IsVerified, p.Role, p.Bio, p.AvatarShape);
    ViewData["Title"] = $"@{p.UserName}";
    ViewData["ProjectPage"] = true;
    ViewData["ShowProfilePins"] = Model.Tab == "posts";
    var basePath = $"/u/{p.UserName}";
    var ret = basePath;
    var websiteOk = Uri.TryCreate(p.Website, UriKind.Absolute, out var wu) && (wu.Scheme == "http" || wu.Scheme == "https");
    var signedIn = User.Identity?.IsAuthenticated == true;
    // Every view but the plain post list gets a short heading (the sidebar already says whose page it is).
    var heading = Model.Tab switch
    {
        "replies" => "comments",
        "media" => "images",
        "likes" => "liked posts",
        "followers" => "followers",
        "following" => "following",
        "tagged" => "posts tagged",
        _ => null,
    };
}
@section Head {
    @if (!p.IsPrivate)
    {
        <link rel="alternate" type="application/atom+xml" title="@@@p.UserName's posts" href="/u/@p.UserName/feed.atom" />
    }
}
@section BaseHeader {
    @if (p.BannerPath is not null)
    {
        <img class="profile-header-image co-container" src="@p.BannerPath" alt="" role="presentation" />
    }
}
@section ProjectSidebar {
    <div class="project-sidebar @(p.BannerPath is not null ? "has-header" : "")">
        @if (signedIn && !Model.IsMe)
        {
            <details class="co-dropdown i-more">
                <summary aria-label="More options for @@@p.UserName"><partial name="_Icon" model="@(new IconModel("more"))" /></summary>
                <ul class="co-menu" role="menu">
                    @if (Model.CanMessage)
                    {
                        <li role="menuitem"><a href="/messages/@p.UserName">message @@@p.UserName</a></li>
                    }
                    <li role="menuitem"><a href="/report?userId=@p.Id">report @@@p.UserName…</a></li>
                    <li role="menuitem"><button type="submit" form="block-form" data-confirm="@(Model.IBlocked ? $"Unblock @{p.UserName}?" : $"Block @{p.UserName}? You won't see each other's posts and they can't message or follow you.")">@(Model.IBlocked ? "unblock" : "block") @@@p.UserName</button></li>
                    @if (User.IsStaff())
                    {
                        <li role="menuitem" class="is-divided"><a href="/admin/user/@p.Id">manage in admin</a></li>
                    }
                </ul>
            </details>
            <form id="block-form" method="post" asp-page="/Act" asp-page-handler="Block" asp-route-id="@p.Id" asp-route-returnUrl="@ret" hidden></form>
        }
        <div class="i-details">
            <div class="i-avatar-container co-drop-shadow">
                <img class="i-avatar co-avatar" data-shape="@AvatarShapes.Resolve(p.AvatarShape)" src="@summary.AvatarUrl" alt="@p.UserName" />
            </div>
            <div class="i-details">
                <h1 class="i-display-name"><a href="@basePath">@p.DisplayName</a></h1>
                <div class="i-handle"><a href="@basePath">@@@p.UserName</a></div>
                @if (!string.IsNullOrWhiteSpace(p.Dek))
                {
                    <div class="i-dek">@p.Dek</div>
                }
                @if (p.IsVerified || p.Role != UserRole.User || Model.FollowsMe || p.IsCurrentlyBanned || p.IsPrivate)
                {
                    <div class="i-badges">
                        @{
                            var badges = new List<string>();
                            if (p.IsVerified) badges.Add("✔ verified");
                            if (p.Role == UserRole.Admin) badges.Add("admin"); else if (p.Role == UserRole.Moderator) badges.Add("moderator");
                            if (Model.FollowsMe) badges.Add("follows you");
                            if (p.IsCurrentlyBanned) badges.Add("banned");
                            if (p.IsPrivate) badges.Add("🔒 private");
                        }
                        @string.Join(" · ", badges)
                    </div>
                }
            </div>
        </div>
        <ul class="i-fields">
            @if (!string.IsNullOrWhiteSpace(p.Pronouns))
            {
                <li class="i-field">
                    <svg class="i-icon" viewBox="0 0 24 24" height="16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" /></svg>
                    <span class="i-value">@p.Pronouns</span>
                </li>
            }
            @if (!string.IsNullOrWhiteSpace(p.Location))
            {
                <li class="i-field">
                    <svg class="i-icon" viewBox="0 0 24 24" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></svg>
                    <span class="i-value">@p.Location</span>
                </li>
            }
            @if (websiteOk)
            {
                <li class="i-field">
                    <svg class="i-icon" viewBox="0 0 24 24" height="16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M19.902 4.098a3.75 3.75 0 00-5.304 0l-4.5 4.5a3.75 3.75 0 001.035 6.037.75.75 0 01-.646 1.353 5.25 5.25 0 01-1.449-8.45l4.5-4.5a5.25 5.25 0 117.424 7.424l-1.757 1.757a.75.75 0 11-1.06-1.06l1.757-1.757a3.75 3.75 0 000-5.304zm-7.389 4.267a.75.75 0 011-.353 5.25 5.25 0 011.449 8.45l-4.5 4.5a5.25 5.25 0 11-7.424-7.424l1.757-1.757a.75.75 0 111.06 1.06l-1.757 1.757a3.75 3.75 0 105.304 5.304l4.5-4.5a3.75 3.75 0 00-1.035-6.037.75.75 0 01-.354-1z" clip-rule="evenodd" /></svg>
                    <a class="i-value" href="@p.Website" rel="me nofollow noopener ugc" target="_blank">@wu!.Host@(wu.AbsolutePath == "/" ? "" : wu.AbsolutePath)</a>
                </li>
            }
        </ul>
        @if (!string.IsNullOrWhiteSpace(p.Bio))
        {
            <div class="i-description prose prose-invert prose-stone isolate co-contain-paint">@Html.Raw(PostRenderer.RenderFragment(p.Bio, Emoji.Current))</div>
        }
        @if (Model.ContactCard.Count > 0)
        {
            var publicItems = Model.ContactCard.Where(c => !c.FollowersOnly).ToList();
            var privateItems = Model.ContactCard.Where(c => c.FollowersOnly).ToList();
            <hr class="i-contact-card-divider" />
            @foreach (var item in publicItems)
            {
                <partial name="_ContactCardItem" model="item" />
            }
            @if (privateItems.Count > 0)
            {
                <details class="i-private-contact-card">
                    <summary class="i-header">
                        <span class="i-label i-closed">show private contact info</span>
                        <span class="i-label i-open">hide private contact info</span>
                        <span class="i-icon"><svg viewBox="0 0 24 24" height="24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.53 16.28a.75.75 0 01-1.06 0l-7.5-7.5a.75.75 0 011.06-1.06L12 14.69l6.97-6.97a.75.75 0 111.06 1.06l-7.5 7.5z" /></svg></span>
                    </summary>
                    @foreach (var item in privateItems)
                    {
                        <partial name="_ContactCardItem" model="item" />
                    }
                </details>
                <hr class="i-contact-card-divider" />
            }
        }
        <div class="i-actions">
            @if (Model.IsMe)
            {
                <a class="co-button is-accent-outline" href="/settings">edit profile</a>
            }
            else if (signedIn)
            {
                @if (!Model.IBlocked && !Model.BlockedMe)
                {
                    <form method="post" asp-page="/Act" asp-page-handler="Follow" asp-route-id="@p.Id" asp-route-returnUrl="@ret">
                        @if (Model.IFollow)
                        {
                            <button type="submit" class="co-button is-accent-outline">unfollow</button>
                        }
                        else if (Model.Requested)
                        {
                            <button type="submit" class="co-button is-accent-outline" title="Waiting for approval. Press to withdraw the request.">requested</button>
                        }
                        else
                        {
                            <button type="submit" class="co-button is-accent">@(p.IsPrivate ? "request to follow" : "follow")</button>
                        }
                    </form>
                }
            }
            else
            {
                <a class="co-button is-accent" href="/account/login?returnUrl=@Uri.EscapeDataString(ret)">follow</a>
            }
        </div>
    </div>
}
@section Aside {
    @if (Model.CanAsk)
    {
        <section class="co-titled-box" role="group" id="ask">
            <h2 class="i-header">ask @@@p.UserName</h2>
            <div class="i-contents">
                <form method="post" asp-page="/Ask" asp-route-userName="@p.UserName" class="stack ask-form">
                    <textarea name="content" rows="3" maxlength="@AskModel.MaxLength" required placeholder="ask @@@p.UserName something" aria-label="Your ask"></textarea>
                    @if (Model.AskMustBeAnonymous)
                    {
                        <p class="muted">You're not logged in, so this ask will be anonymous.</p>
                    }
                    else if (p.AnonAsksAllowed)
                    {
                        <div class="field-row"><input type="checkbox" id="ask-anon" name="anonymous" value="true" /><label for="ask-anon">ask anonymously</label></div>
                    }
                    <div><button type="submit" class="co-button is-small">send ask</button></div>
                </form>
            </div>
        </section>
    }
    @if (Model.PinnedTags.Count > 0)
    {
        <section class="co-titled-box" role="group">
            <h2 class="i-header">pinned tags</h2>
            <div class="i-contents">
                <ul class="i-tag-list">
                    @foreach (var t in Model.PinnedTags)
                    {
                        <li><a class="co-tag-button" href="@basePath/tagged/@Uri.EscapeDataString(t)" aria-current="@(Model.Tagged == t ? "page" : "false")">@t</a></li>
                    }
                </ul>
            </div>
        </section>
    }
    <section class="co-titled-box" role="group">
        <h2 class="i-header">more from @@@p.UserName</h2>
        <div class="i-contents">
            <ul class="project-links">
                <li><a class="i-link" href="@basePath" aria-current="@(Model.Tab == "posts" ? "page" : "false")">posts <span>@Model.PostCount</span></a></li>
                <li><a class="i-link" href="@basePath/replies" aria-current="@(Model.Tab == "replies" ? "page" : "false")">comments</a></li>
                <li><a class="i-link" href="@basePath/media" aria-current="@(Model.Tab == "media" ? "page" : "false")">images</a></li>
                <li><a class="i-link" href="@basePath/likes" aria-current="@(Model.Tab == "likes" ? "page" : "false")">likes</a></li>
                <li><a class="i-link" href="@basePath/followers" aria-current="@(Model.Tab == "followers" ? "page" : "false")">followers <span>@Model.FollowerCount</span></a></li>
                <li><a class="i-link" href="@basePath/following" aria-current="@(Model.Tab == "following" ? "page" : "false")">following <span>@Model.FollowingCount</span></a></li>
            </ul>
            <p class="i-joined">joined @Fmt.Date(p.CreatedAt)</p>
        </div>
    </section>
}

@if (Model.BlockedMe)
{
    <div class="co-info-box is-warning i-shield-exclam-icon"><div class="i-text">You can't view this account's posts.</div></div>
}
else if (Model.IsLockedOut)
{
    <div class="co-info-box is-draft i-info-circle-icon"><div class="i-text">🔒 @@@p.UserName's page is private. Only people they approve can see their posts@(Model.Requested ? " — your follow request is waiting for approval." : ".")</div></div>
}
else
{
    @if (heading is null)
    {
        <div class="project-profile-filters">
            <div class="i-filter" data-state="@(Model.HideShares ? "true" : "false")">
                <a class="i-state" href="@Model.FilterUrl(false, Model.HideReplies, Model.HideAsks)"><span class="i-state">show</span> <span class="i-label">shares</span></a>
                <a class="i-state" href="@Model.FilterUrl(true, Model.HideReplies, Model.HideAsks)"><span class="i-state">hide</span> <span class="i-label">shares</span></a>
            </div>
            <div class="i-filter" data-state="@(Model.HideReplies ? "true" : "false")">
                <a class="i-state" href="@Model.FilterUrl(Model.HideShares, false, Model.HideAsks)"><span class="i-state">show</span> <span class="i-label">replies</span></a>
                <a class="i-state" href="@Model.FilterUrl(Model.HideShares, true, Model.HideAsks)"><span class="i-state">hide</span> <span class="i-label">replies</span></a>
            </div>
            <div class="i-filter" data-state="@(Model.HideAsks ? "true" : "false")">
                <a class="i-state" href="@Model.FilterUrl(Model.HideShares, Model.HideReplies, false)"><span class="i-state">show</span> <span class="i-label">asks</span></a>
                <a class="i-state" href="@Model.FilterUrl(Model.HideShares, Model.HideReplies, true)"><span class="i-state">hide</span> <span class="i-label">asks</span></a>
            </div>
        </div>
    }
    else
    {
        <div class="project-profile-heading">
            <h2 class="i-title">
                @heading
                @if (Model.Tab == "tagged")
                {
                    <span class="i-tag">#@Model.Tagged</span>
                }
            </h2>
            <div class="i-links">
                <a class="i-pill" href="@basePath">
                    <svg viewBox="0 0 24 24" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
                    all posts
                </a>
                @if (Model.Tab == "tagged")
                {
                    <a class="i-pill" href="/tag/@Uri.EscapeDataString(Model.Tagged!)">#@Model.Tagged from everyone</a>
                }
            </div>
        </div>
    }
    @if (Model.IBlocked)
    {
        <div class="co-info-box is-warning i-shield-exclam-icon"><div class="i-text">You blocked @@@p.UserName. Their posts are hidden from you.</div></div>
    }
    @if (Model.Tab is "followers" or "following")
    {
        <card>
            <partial name="_UserList" model="@(new UserListModel(Model.People, Model.Tab == "followers" ? "No followers yet." : "Not following anyone yet."))" />
        </card>
    }
    else
    {
        <partial name="_PostList" model="@(new PostListModel(Model.Posts, Model.Tab switch { "replies" => "No comments yet.", "media" => "No images yet.", "likes" => "No liked posts yet.", "tagged" => "No posts with this tag.", _ => "No posts yet." }, Model.MoreUrl, Preview: false))" />
    }
}
