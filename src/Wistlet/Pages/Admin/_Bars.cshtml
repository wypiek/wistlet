@model List<Wistlet.Pages.Admin.IndexModel.Day>
@{
    var max = Math.Max(1, Model.Max(d => d.Count));
}
@* One 7.css progress bar per day, scaled to the busiest day. *@
<table>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.Date.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture)</td>
                <td style="width:55%"><div role="progressbar" aria-valuemin="0" aria-valuemax="@max" aria-valuenow="@d.Count"><div style="width:@(Math.Round(d.Count * 100.0 / max, 1).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div></td>
                <td>@d.Count</td>
            </tr>
        }
    </tbody>
</table>
