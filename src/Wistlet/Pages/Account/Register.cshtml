@page "/account/register"
@model Wistlet.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create an account";
    ViewData["NoSidebar"] = true;
}
<card title="@($"Join {Settings.Current.SiteName}")" class="narrow">
    @if (Model.Closed)
    {
        <p>Registration is currently closed. Please check back later.</p>
        <p><a href="/account/login">Back to log in</a></p>
    }
    else
    {
        <form method="post" class="form-grid">
            <div asp-validation-summary="ModelOnly" class="full" role="alert"></div>
            <label asp-for="UserName"></label>
            <div><input asp-for="UserName" autocomplete="username" maxlength="20" autofocus /> <span asp-validation-for="UserName"></span></div>
            <span></span>
            <span>3–20 letters, numbers or underscores. This is your @@handle.</span>
            <label asp-for="DisplayName"></label>
            <div><input asp-for="DisplayName" maxlength="50" /> <span asp-validation-for="DisplayName"></span></div>
            <label asp-for="Email"></label>
            <div><input asp-for="Email" autocomplete="email" /> <span asp-validation-for="Email"></span></div>
            <label asp-for="Password"></label>
            <div><input asp-for="Password" autocomplete="new-password" /> <span asp-validation-for="Password"></span></div>
            <label asp-for="ConfirmPassword"></label>
            <div><input asp-for="ConfirmPassword" autocomplete="new-password" /> <span asp-validation-for="ConfirmPassword"></span></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <span></span>
            <div><button type="submit" class="default">Create account</button></div>
        </form>
        <p>Already have an account? <a href="/account/login">Log in</a></p>
    }
</card>
