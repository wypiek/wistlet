@page
@model NotificationsModel
@{
    ViewData["Title"] = "Notifications";

    // "annie", "annie and pete", "annie, pete and 3 others"
    IHtmlContent Names(IReadOnlyList<UserSummary> actors)
    {
        var links = actors.Take(2).Select(a => $"<a class=\"i-name\" href=\"/u/{a.UserName}\">{System.Net.WebUtility.HtmlEncode(a.DisplayName)}</a>").ToList();
        var others = actors.Count - links.Count;
        var text = others switch
        {
            0 when links.Count == 2 => $"{links[0]} and {links[1]}",
            0 => links.FirstOrDefault() ?? "someone",
            _ => $"{string.Join(", ", links)} and {Fmt.Plural(others, "other")}",
        };
        return new HtmlString(text);
    }
}
@using Microsoft.AspNetCore.Html
<h1 class="page-title">notifications</h1>
@if (Model.Days.Count == 0)
{
    <div class="co-info-box is-tombstone i-info-circle-icon"><div class="i-text">You're all caught up. Likes, comments, shares, mentions and new followers show up here.</div></div>
}
else
{
    <div class="row">
        <span class="muted">@Fmt.Plural(Model.UnreadCount, "new notification")</span>
        <form method="post" asp-page-handler="Clear" data-confirm="Delete all notifications?" class="notification-clear">
            <button type="submit" class="co-button is-outline is-small">clear all</button>
        </form>
    </div>
    @foreach (var day in Model.Days)
    {
        <card title="@day.Label" class="notification-day">
            <ul class="co-notification-list">
                @foreach (var g in day.Groups)
                {
                    var postLink = g.PostId is int pid ? $"/post/{pid}" : null;
                    var postRef = g.PostExcerpt is null ? "your post" : $"your post “{g.PostExcerpt}”";
                    <li class="co-notification @(g.IsUnread ? "is-unread" : "")">
                        <div class="i-avatars">
                            @foreach (var a in g.Actors.Take(4))
                            {
                                <a href="/u/@a.UserName" tabindex="-1" title="@@@a.UserName"><img class="co-avatar" data-shape="@a.AvatarShape" src="@a.AvatarUrl" alt="@a.UserName" loading="lazy" /></a>
                            }
                            @if (g.Actors.Count == 0)
                            {
                                <span class="i-system-icon" aria-hidden="true"><partial name="_Icon" model="@(new IconModel("shield"))" /></span>
                            }
                        </div>
                        <div class="i-text">
                            <p>
                                @if (g.IsUnread) { <span class="i-unread-dot" title="new"></span> }
                                @switch (g.Type)
                                {
                                    case NotificationType.Like:
                                        @Names(g.Actors) <text> liked </text><a href="@postLink">@postRef</a>
                                        break;
                                    case NotificationType.Share:
                                        @Names(g.Actors) <text> shared </text><a href="@postLink">@postRef</a>
                                        break;
                                    case NotificationType.Follow:
                                        @Names(g.Actors) <text> started following you</text>
                                        break;
                                    case NotificationType.Reply:
                                        @Names(g.Actors) <text> commented on </text><a href="/post/@g.ActivityPostId">@(g.PostExcerpt is null ? "your post" : $"“{g.PostExcerpt}”")</a>
                                        break;
                                    case NotificationType.Mention:
                                        @Names(g.Actors) <text> </text><a href="/post/@g.ActivityPostId">mentioned you</a>
                                        break;
                                    default:
                                        <b>message from the moderators</b>
                                        break;
                                }
                                <span class="i-time">· @Fmt.Time(g.LatestAt)</span>
                            </p>
                            @if (g.ActivityExcerpt is not null)
                            {
                                <blockquote class="i-excerpt">@g.ActivityExcerpt</blockquote>
                            }
                            @if (g.Message is not null)
                            {
                                <p class="i-excerpt">@g.Message</p>
                            }
                        </div>
                    </li>
                }
            </ul>
        </card>
    }
}
