# Copy to .env and adjust. All values are optional.
WISTLET_PORT=8080
WISTLET_ADMIN_USER=admin
WISTLET_ADMIN_PASSWORD=change-me-please
WISTLET_ADMIN_EMAIL=admin@example.com
WISTLET_SEED_DEMO=false

# Public address of the site, used for links in e-mails.
WISTLET_PUBLIC_URL=https://wistlet.example.com

# SMTP for password reset e-mails (leave WISTLET_SMTP_HOST empty to turn resets by e-mail off).
WISTLET_SMTP_HOST=
WISTLET_SMTP_PORT=587
# Auto, StartTls, SslOnConnect (port 465) or None
WISTLET_SMTP_SECURITY=Auto
WISTLET_SMTP_USER=
WISTLET_SMTP_PASSWORD=
WISTLET_SMTP_FROM=wistlet@example.com
